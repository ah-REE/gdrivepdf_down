{
  "manifest_version": 3,
  "name": "GDrive Down - Capture",
  "version": "1.0.0",
  "description": "Capture view-only Google Drive files to PDF, fully automatically. Runs locally.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["https://drive.google.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://drive.google.com/*"],
      "js": ["capture.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gdrivedown.vercel.app/*",
        "http://127.0.0.1:8756/*",
        "http://localhost:8756/*",
        "http://localhost:5173/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "GDrive Down" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
